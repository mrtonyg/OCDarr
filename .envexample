SONARR_URL=http://localhost:8989
SONARR_API_KEY=YOUR_SONARR_API_KEY_HERE
# Optional: only needed if SONARR_URL is an address the container can reach
# but a browser can't (e.g. host.docker.internal, a Docker service name, or
# a Tailscale/VPN-only address). Defaults to SONARR_URL when unset. Used only
# for the poster/banner <img> src and "view in Sonarr" links sent to the
# browser - all server-to-server API calls keep using SONARR_URL.
#SONARR_PUBLIC_URL=http://192.168.1.10:8989
PLEX_TOKEN=plex_token
PLEX_URL=http://plex_url:32400
JELLYFIN_TOKEN=jf_token
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_USER_ID=username
JELLYSEERR_URL=http://oversserorjellyseer:5055
JELLYSEERR_API_KEY=api_key
RADARR_URL=http://radarr:7878
RADARR_API_KEY=api_key
# Optional: same idea as SONARR_PUBLIC_URL, for Radarr. Defaults to RADARR_URL.
#RADARR_PUBLIC_URL=http://192.168.1.10:7878
